# Copy this file to .env on the production server.
# Keep .env outside version control and never paste real values into scripts.

NODE_ENV=production
PORT=10014
DATABASE_URL=mysql://user:password@127.0.0.1:3306/swiftx

# Admin panel credentials and private route
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_URL=/replace-with-a-private-admin-path

# Production authentication
AUTH_MODE=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=

# Public URL used for Telegram webhooks and links
PROJECT_URL=https://example.com

# Optional Nginx server_name override. Use spaces for multiple hostnames.
# SWIFTX_DOMAIN=pay.example.com www.pay.example.com
# Optional Nginx site path overrides:
# SWIFTX_NGINX_CONFIG=/etc/nginx/sites-available/swiftx.conf
# SWIFTX_NGINX_ENABLED_CONFIG=/etc/nginx/sites-enabled/swiftx.conf

# Persistent upload storage. Keep this outside the release checkout.
SWIFTX_UPLOADS_DIR=/var/lib/swiftx/uploads

# Optional frontend build path. Keep "/" when nginx serves the domain root.
BASE_PATH=/

# Optional: override the isolated PM2 process name.
# SWIFTX_PM2_NAME=swiftx-api