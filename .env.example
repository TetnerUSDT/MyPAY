# Copy this file to .env on the production server.
# Keep .env outside version control and never paste real values into scripts.

NODE_ENV=production
PORT=10014
DATABASE_URL=mysql://user:password@127.0.0.1:3306/swiftx

# Production authentication
AUTH_MODE=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=

# Public URL used for Telegram webhooks and links
PROJECT_URL=https://example.com

# Optional frontend build path. Keep "/" when nginx serves the domain root.
BASE_PATH=/

# Optional: override the isolated PM2 process name.
# SWIFTX_PM2_NAME=swiftx-api