# ===========================================
# SwiftX Configuration Environment Variables
# ===========================================

# Choose authentication mode: 'test' or 'telegram'
AUTH_MODE=test

# ============= TEST MODE SETTINGS =============
# When AUTH_MODE=test, users can authenticate with just a name
# Ideal for development and testing

# Enable/disable test authentication (default: true in development)
ENABLE_TEST_AUTH=true

# ============= TELEGRAM MODE SETTINGS =============
# When AUTH_MODE=telegram, full Telegram WebApp integration is required

# Telegram Bot Token (required for telegram mode)
# Get this from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whether to validate Telegram initData HMAC (default: true)
# Set to false only for testing purposes
VALIDATE_TELEGRAM_INITDATA=true

# ============= SERVER SETTINGS =============
# Server environment
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# ============= EXAMPLE CONFIGURATIONS =============

# --- For Development/Testing ---
# AUTH_MODE=test
# ENABLE_TEST_AUTH=true
# NODE_ENV=development

# --- For Production with Telegram ---
# AUTH_MODE=telegram
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# VALIDATE_TELEGRAM_INITDATA=true
# NODE_ENV=production

# ============= USAGE NOTES =============
# 1. Copy this file to .env and adjust values for your environment
# 2. To switch modes, simply change AUTH_MODE
# 3. All API endpoints remain the same - only authentication method changes
# 4. Test mode allows Postman/curl testing with API keys
# 5. Telegram mode provides full security for production use